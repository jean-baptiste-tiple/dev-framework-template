# ============================================
# App
# ============================================
# URL publique du site. Lue par les redirections d'auth (emailRedirectTo,
# resetPasswordForEmail) et par les métadonnées SEO (metadataBase, sitemap, robots).
# Sans elle, les liens de confirmation d'email pointent vers "undefined/auth/callback".
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# Supabase (ajouter après activation du starter supabase-auth)
# ============================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_PROJECT_ID=your-project-id
